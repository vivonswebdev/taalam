{
  "$schema": "https://raw.githubusercontent.com/nicerobot/Tauri/dev/schemas/config.schema.json",
  "productName": "Taaloum",
  "version": "1.0.0",
  "identifier": "be.taalam.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "title": "Taaloum - Apprendre le Coran",
    "windows": [
      {
        "title": "Taaloum",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
